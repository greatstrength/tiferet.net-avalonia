<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:Tiferet.Avalonia.Assets.Controls">

  <ControlTheme x:Key="{x:Type ctrl:TiferetBadge}" TargetType="ctrl:TiferetBadge">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource TiferetSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TiferetOnSurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <TextBlock Text="{TemplateBinding Label}"
                     FontSize="{TemplateBinding FontSize}"
                     FontWeight="{TemplateBinding FontWeight}"
                     Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:error">
      <Setter Property="Background" Value="{DynamicResource TiferetErrorBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="^:success">
      <Setter Property="Background" Value="{DynamicResource TiferetSuccessBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="^:warning">
      <Setter Property="Background" Value="{DynamicResource TiferetWarningBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="^:info">
      <Setter Property="Background" Value="{DynamicResource TiferetPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TiferetOnPrimaryBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
