<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:Tiferet.Avalonia.Assets.Controls">

  <ControlTheme x:Key="{x:Type ctrl:TiferetSkeleton}" TargetType="ctrl:TiferetSkeleton">
    <Setter Property="Width" Value="200" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource TiferetOutlineBrush}" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Shape"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}"
                Opacity="{TemplateBinding Opacity}">
          <Border.Styles>
            <Style Selector="Border#PART_Shape">
              <Style.Animations>
                <Animation Duration="0:0:1.5"
                           IterationCount="INFINITE"
                           PlaybackDirection="Alternate">
                  <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.4" />
                  </KeyFrame>
                  <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.8" />
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </Border.Styles>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Variant: circular -->
    <Style Selector="^:circular">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- Variant: text (thinner, line-like) -->
    <Style Selector="^:text">
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
