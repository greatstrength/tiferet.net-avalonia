<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:Tiferet.Avalonia.Assets.Controls">

  <ControlTheme x:Key="{x:Type ctrl:TiferetCard}" TargetType="ctrl:TiferetCard">
    <Setter Property="Background" Value="{DynamicResource TiferetSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BorderBrush" Value="{DynamicResource TiferetOutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="0 1 3 0 #1A000000">
          <StackPanel Spacing="8">
            <ContentPresenter x:Name="PART_Header"
                              Content="{TemplateBinding Header}"
                              IsVisible="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ContentPresenter x:Name="PART_Content"
                              Content="{TemplateBinding Content}" />
            <ContentPresenter x:Name="PART_Footer"
                              Content="{TemplateBinding Footer}"
                              IsVisible="{Binding Footer, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
