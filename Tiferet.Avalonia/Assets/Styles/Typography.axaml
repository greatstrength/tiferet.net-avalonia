<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Display -->
  <x:Double x:Key="TiferetDisplayLargeFontSize">57</x:Double>
  <x:Double x:Key="TiferetDisplayMediumFontSize">45</x:Double>
  <x:Double x:Key="TiferetDisplaySmallFontSize">36</x:Double>

  <!-- Headline -->
  <x:Double x:Key="TiferetHeadlineLargeFontSize">32</x:Double>
  <x:Double x:Key="TiferetHeadlineMediumFontSize">28</x:Double>
  <x:Double x:Key="TiferetHeadlineSmallFontSize">24</x:Double>

  <!-- Title -->
  <x:Double x:Key="TiferetTitleLargeFontSize">22</x:Double>
  <x:Double x:Key="TiferetTitleMediumFontSize">16</x:Double>
  <x:Double x:Key="TiferetTitleSmallFontSize">14</x:Double>

  <!-- Body -->
  <x:Double x:Key="TiferetBodyLargeFontSize">16</x:Double>
  <x:Double x:Key="TiferetBodyMediumFontSize">14</x:Double>
  <x:Double x:Key="TiferetBodySmallFontSize">12</x:Double>

  <!-- Label -->
  <x:Double x:Key="TiferetLabelLargeFontSize">14</x:Double>
  <x:Double x:Key="TiferetLabelMediumFontSize">12</x:Double>
  <x:Double x:Key="TiferetLabelSmallFontSize">11</x:Double>

</ResourceDictionary>
